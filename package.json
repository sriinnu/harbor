{
  "name": "harbor",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "format": "./Scripts/swiftformat.sh",
    "lint": "./Scripts/swiftlint.sh",
    "coverage": "./Scripts/coverage.sh",
    "check": "pnpm format && pnpm lint",
    "check:coverage": "pnpm coverage",
    "docs:list": "node Scripts/docs-list.mjs",
    "test": "./Scripts/test.sh",
    "build": "node Scripts/build.mjs",
    "harbor": "swift build --build-path build/macos/.build --product harborcli && ./Scripts/codesign_cli.sh build/macos/.build/debug/harborcli && build/macos/.build/debug/harborcli",
    "harborcli": "pnpm -s harbor",
    "start": "./Scripts/compile_and_run.sh",
    "restart": "./Scripts/compile_and_run.sh",
    "stop": "pkill -f \"Harbor.app/Contents/MacOS/Harbor\" || true",
    "codegen": "./Scripts/apollo_codegen.sh",
    "ghql": "pnpm exec tsx Scripts/ghql.ts",
    "ghrest": "pnpm exec tsx Scripts/ghrest.ts"
  },
  "dependencies": {
    "graphql": "^16.12.0"
  },
  "devDependencies": {
    "@octokit/request": "^10.0.7",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv-cli": "^11.0.0",
    "ora": "^9.0.0",
    "tsx": "^4.21.0",
    "zod": "^4.6.7"
  }
}
