// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // GitHub specific
  githubId       String?  @unique
  githubUsername String?  @unique
  githubToken    String?  @db.Text
  githubTokenExp DateTime?

  // App specific
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  preferences     UserPreferences?
  pinnedRepos     PinnedRepository[]
  teamMemberships TeamMember[]
  subscription    Subscription?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User Preferences
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Display preferences
  theme            String  @default("system") // "light" | "dark" | "system"
  itemsPerPage     Int     @default(20)
  defaultView      String  @default("grid") // "grid" | "list"
  showPrivateRepos Boolean @default(true)
  showArchivedRepos Boolean @default(false)

  // Filter preferences
  defaultSort      String @default("updated") // "updated" | "stars" | "name" | "created"
  defaultLanguage  String?
  defaultOrg       String?

  // Notification preferences
  emailNotifications     Boolean @default(true)
  desktopNotifications   Boolean @default(false)
  notifyOnStarThreshold  Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pinned Repositories
model PinnedRepository {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Repository info
  githubId     Int
  name         String
  owner        String
  fullName     String
  description  String?
  url          String
  stars        Int     @default(0)
  language     String?
  isPrivate    Boolean @default(false)

  // Pinning metadata
  order        Int     @default(0)
  notes        String?
  tags         String[] // Array of custom tags
  pinnedAt     DateTime @default(now())

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, githubId])
  @@index([userId])
  @@index([fullName])
}

// Teams (for shared repository collections)
model Team {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  avatarUrl   String?

  // Settings
  isPublic    Boolean      @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     TeamMember[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role   String @default("member") // "owner" | "admin" | "member"

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// Subscriptions (Stripe integration)
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stripe specific
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // Subscription details
  plan           String    @default("free") // "free" | "pro" | "team"
  status         String    @default("active") // "active" | "canceled" | "past_due"

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// GitHub API Cache
model GitHubCache {
  id        String   @id @default(cuid())

  // Cache key components
  userId    String
  endpoint  String
  query     String?  @db.Text

  // Cache data
  data      Json
  etag      String?

  // Timestamps
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint, query])
  @@index([userId])
  @@index([expiresAt])
}
