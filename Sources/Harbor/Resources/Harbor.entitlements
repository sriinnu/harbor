<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Developer ID build, hardened runtime, not sandboxed (like Runic): local Git
      needs ~/.ssh, ~/.gitconfig and credential helpers, which a sandbox blocks.
      "Open in Terminal" drives the terminal app through osascript.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
